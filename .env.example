# Zoom Meeting SDK (Server-to-Server OAuth)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_MEETING_ID=
ZOOM_MEETING_PASSWORD=

# Claude API
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Google Cloud STT (auth via Application Default Credentials / GCE metadata)
GOOGLE_CLOUD_PROJECT=scopio-lab-bpa-demo
STT_LANGUAGE=en-US
STT_MODEL=latest_short

# ElevenLabs TTS
ELEVENLABS_API_KEY=
# Matilda (en). French demos default to Chloé when DEMO_LANGUAGE=fr and this is unset.
ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX
TTS_MODEL=eleven_turbo_v2

# Redis
REDIS_URL=redis://localhost:6379

# ScopioLabs BMA
BMA_URL=
BMA_USERNAME=
BMA_PASSWORD=

# Agent
AGENT_NAME=Alex
PROSPECT_NAME=
DEMO_LANGUAGE=en
AUTO_DEMO=true
LOG_LEVEL=info

# Voice loop testing (zoom-bot)
AUDIO_INPUT_FILE=
AUDIO_OUTPUT_DIR=/tmp/scopio_audio
AUDIO_OUTPUT=file
