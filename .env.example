# Zoom Meeting SDK (Server-to-Server OAuth)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_MEETING_ID=
ZOOM_MEETING_PASSWORD=

# Claude API
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Google Cloud STT (auth via Application Default Credentials / GCE metadata)
GOOGLE_CLOUD_PROJECT=scopio-lab-bpa-demo
STT_LANGUAGE=en-US
STT_MODEL=latest_short

# ElevenLabs TTS
ELEVENLABS_API_KEY=
# Matilda (en). French demos default to Chloé when DEMO_LANGUAGE=fr and this is unset.
ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX
TTS_MODEL=eleven_turbo_v2

# Redis
REDIS_URL=redis://localhost:6379

# ScopioLabs BMA
BMA_URL=
BMA_USERNAME=
BMA_PASSWORD=

# Google Meet mode (docker compose --profile meet up; alternative to Zoom)
MEET_URL=
MEET_BOT_NAME=Scopio Demo Agent
GOOGLE_EMAIL=
GOOGLE_PASSWORD=
# Which bot the orchestrator drives: zoom-bot:50057 (default) or meet-bot:50057
DEMO_BROWSER_GRPC_ADDR=

# Meeting launcher web UI (docker compose --profile launcher up, or
# scripts/install-launcher.sh for the systemd install)
LAUNCHER_USER=scopio
LAUNCHER_PASS=

# Agent
AGENT_NAME=Alex
PROSPECT_NAME=
DEMO_LANGUAGE=en
AUTO_DEMO=true
LOG_LEVEL=info
# STT confidence floor (live-tuned; Google scores short real speech low)
MIN_CONFIDENCE=0.3
# Keep capturing meeting audio while the bot speaks so prospects can barge in
# mid-narration; set false for hard echo suppression at the audio layer
CAPTURE_DURING_PLAYBACK=true

# Voice loop testing (zoom-bot)
AUDIO_INPUT_FILE=
AUDIO_OUTPUT_DIR=/tmp/scopio_audio
AUDIO_OUTPUT=file
